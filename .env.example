# ==============================================================================
# ScholarScout AI Engine Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NVIDIA NIM & OpenAI-Compatible LLM Multi-Key Pool
# ------------------------------------------------------------------------------
# NVIDIA NIM API Endpoint (Default): https://integrate.api.nvidia.com/v1
# Other OpenAI-Compatible Endpoints: https://api.openai.com/v1, http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Multi-Key Pool for Round-Robin Load Balancing & Rate-Limit (429) Failover
# You can supply multiple keys separated by commas:
NVIDIA_API_KEYS=nvapi-key1_here, nvapi-key2_here, nvapi-key3_here

# Single Key Fallback (if only using one key)
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM Model Selection
# ------------------------------------------------------------------------------
# Available Curated NVIDIA Models:
# - nvidia/llama-3.1-nemotron-70b-instruct  (Nemotron 70B - Recommended Flagship Default)
# - meta/llama-3.3-70b-instruct             (Llama 3.3 70B - Advanced Reasoning)
# - deepseek-ai/deepseek-r1                 (DeepSeek R1 - Advanced Math & Code Reasoning)
# - meta/llama-3.1-70b-instruct             (Llama 3.1 70B - High Accuracy)
# - qwen/qwen2.5-72b-instruct               (Qwen 2.5 72B - Multilingual Worldwide Extraction)
# - mistralai/mistral-large-2-instruct      (Mistral Large 2 123B)
# - meta/llama-3.1-8b-instruct              (Llama 3.1 8B - Fast High-Throughput Scraping)
# - mistralai/mixtral-8x7b-instruct-v0.1    (Mixtral 8x7B MoE)
# - nvidia/nemotron-4-340b-instruct         (Nemotron 4 340B Heavyweight)
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Automatic Fallback Models (used if primary model encounters temporary provider downtime)
LLM_FALLBACK_MODELS=meta/llama-3.3-70b-instruct,meta/llama-3.1-70b-instruct,deepseek-ai/deepseek-r1,meta/llama-3.1-8b-instruct

# Request & Concurrency Control
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_CONCURRENCY=3
LLM_MAX_RETRIES=3

# Per-Job Request and Token Safety Budgets
JOB_MAX_LLM_REQUESTS=35
JOB_MAX_LLM_TOKENS=100000

# ------------------------------------------------------------------------------
# 3. Autonomous Discovery Mode & Pluggable Search Providers
# ------------------------------------------------------------------------------
# Supported Search Providers:
# - tavily: https://tavily.com (AI-optimized academic search)
# - serpapi: https://serpapi.com (Structured Google Search API)
# - brave: https://brave.com/search/api (Independent index with privacy)
# - empty / none: University URL Mode & URL-list import fallback
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Optional Provider-Specific Fallback Keys
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# Discovery Limits & Safety Quotas
SEARCH_MAX_QUERIES_PER_JOB=5
SEARCH_MAX_RESULTS_PER_QUERY=10
DISCOVERY_MAX_UNIVERSITIES=8

# ------------------------------------------------------------------------------
# 4. Application Server & Local Database
# ------------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8001
DATABASE_PATH=scholarships.db
CRAWL_MAX_PAGES=15
CRAWL_TIMEOUT_SECONDS=12
DEBUG_MODE=True
